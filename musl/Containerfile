# Two-stage build proving the musl static-build requirement from
# LLM/agent-context.md hard goal 3 ("must run on even the most minimal Linux
# system... statically linked, zero dynamic runtime dependencies") and the
# CI gate described under "Test/benchmark harness architecture" ("Rust CI
# also gates on a musl static build smoke-tested inside a minimal
# (scratch/busybox-level) container").
#
# Build context is a staged copy of the workspace (Cargo.toml, Cargo.lock, .cargo/, crates/) + fixtures/ (smoke_test.sh makes it:
# fixtures/ is a symlink out of the repo, #311), so the fixture tree at
# fixtures/ can be copied into the runtime image too, letting the smoke
# test exercise real `emerge --pretend` against it.
#
# Build stage uses Alpine (musl-based) purely for its `rust`/`cargo` apk
# packages -- no rustup/target-add needed, since Alpine's own rustc targets
# musl (x86_64-alpine-linux-musl) natively. 3.24.1 is the first stable
# Alpine whose rustc (1.96.1) clears the workspace's 1.95 MSRV floor
# (gentoo-interner / portage-atom*; see backlog #61).
# .cargo/config.toml forces
# relocation-model=static plus the trailing -Wl,-Bstatic that keeps gcc's
# own -lc static, so the output has no dynamic section at all, not even a
# reference to musl's own dynamic loader.
#
# Runtime stage is `FROM scratch`: the strictest possible check that the
# binaries have zero runtime dependencies, not even a libc.

FROM docker.io/library/alpine:3.24.1 AS builder
RUN apk add --no-cache rust cargo
WORKDIR /work
COPY Cargo.toml Cargo.lock ./
COPY .cargo/ .cargo/
COPY crates/ crates/
# backlog #322 S2: `build.rs` embeds the vendored phase runtime and the package-set
# definitions, so they must be in the build context.
COPY bin/ bin/
COPY cnf/ cnf/
# feat#157 (#305) S2.1: Q6 default, vdb-sqlite and vdb-redb are OFF in the
# minimal static build profile. Use --no-default-features to exclude them.
RUN cargo build --release --target x86_64-alpine-linux-musl \
    --no-default-features \
    --package versions-harness --package atom-harness \
    --package use-reduce-harness --package required-use-harness --package portuale

FROM scratch AS runtime
COPY --from=builder /work/target/x86_64-alpine-linux-musl/release/versions-harness /bin/versions-harness
COPY --from=builder /work/target/x86_64-alpine-linux-musl/release/atom-harness /bin/atom-harness
COPY --from=builder /work/target/x86_64-alpine-linux-musl/release/use-reduce-harness /bin/use-reduce-harness
COPY --from=builder /work/target/x86_64-alpine-linux-musl/release/required-use-harness /bin/required-use-harness
# Real deployment would install this binary once and create `emerge`/
# `ebuild` symlinks (proven on the host filesystem by the contract
# suite's test_portuale.py); scratch has no shell to `ln` at image
# build time, so the smoke test copies the same binary under each applet
# name instead. Dispatch is by argv[0] basename either way -- the binary
# can't tell a symlink from a hardlink from a separate copy.
COPY --from=builder /work/target/x86_64-alpine-linux-musl/release/portuale /bin/portuale
COPY --from=builder /work/target/x86_64-alpine-linux-musl/release/portuale /bin/emerge
COPY --from=builder /work/target/x86_64-alpine-linux-musl/release/portuale /bin/ebuild
# The synthetic repo/vdb tree emerge --pretend is exercised against inside
# the container (see fixtures/ and crates/portage-repo).
COPY fixtures/ /fixtures/
ENTRYPOINT ["/bin/versions-harness"]

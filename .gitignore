# Python
*.py[co]
__pycache__/
*.class
*.so
/build
/tags
/.tox/
setup.cfg
.*.swp
*.vim
.mypy_cache
dist
*.egg-info/
MANIFEST

# Portuale
rust/target
.pytest_cache/
.claude/settings.local.json
helpers

# ...but the vendored Portage helpers named `*.so` are shell scripts /
# symlinks (dolib.so, newlib.so), not compiled objects.
!bin/ebuild-helpers/*.so

# Third-party working checkouts -- pinned in 3rdparty/repos.toml, cloned
# by the bootstrap step, never committed. (repos.toml itself IS tracked.)
/3rdparty/*/

# Fixture runtime scratch (regenerated by test runs)
/fixtures/var/cache/
/fixtures/var/db/.pkg.portage_lockfile

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

+                .ok()
+                .flatten()
+        {
+            pkgs.push(InfoPkg::Binary(b));
+        }
+    }
+    print_info_packages(PrintInfoPackagesArgs {
+        pkgs: &pkgs,
+        config,
+        color,
+        root,
+        debug,

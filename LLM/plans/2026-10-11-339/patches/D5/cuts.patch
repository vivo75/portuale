+// Each flag token is coloured; `--info` always shows every flag.
+fn use_line(disp: &[(String, String)], color: &Colorizer) -> String {
+    disp.iter()
+        .map(|(name, body)| {
+            let colored = if body.is_empty() {
+                String::new()
+            } else {
+                body.split(' ')
+                    .map(|t| colorize_use_token(t, color))
+                    .collect::<Vec<_>>()
+                    .join(" ")
+            };
+            format!("{name}=\"{colored}\"")
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
+}

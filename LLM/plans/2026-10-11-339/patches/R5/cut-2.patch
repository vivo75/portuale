+/// The values [`commit_selection`] reads from its caller.
+pub(crate) struct CommitSelectionArgs<'a, 'x0> {
+    pub(crate) retlist: &'a mut Vec<usize>,
+    pub(crate) entries: &'a [GraphEntry],
+    pub(crate) g: &'a mut Digraph,
+    pub(crate) selected: Vec<usize>,
+    pub(crate) asap: &'a [usize],
+    pub(crate) mo_iter: usize,
+    pub(crate) prefer_asap: &'a mut bool,
+    pub(crate) drop_satisfied: &'a mut bool,
+    pub(crate) used_ig: Option<Ignore>,
+    pub(crate) frontier: &'a mut Option<SerializeFrontier>,
+    pub(crate) tree: &'a mut Option<&'x0 mut TreeStuck>,
+}
+
+/// Trace the selection, then remove the selected nodes from the graph and append them to the merge list.
+pub(crate) fn commit_selection(args: CommitSelectionArgs<'_, '_>) {
+    let CommitSelectionArgs {
+        retlist,
+        entries,
+        g,
+        selected,
+        asap,
+        mo_iter,
+        prefer_asap: prefer_asap_out,
+        drop_satisfied: drop_satisfied_out,
+        used_ig,
+        frontier,
+        tree,
+    } = args;
+    let mut prefer_asap = *prefer_asap_out;
+    let mut drop_satisfied = *drop_satisfied_out;
+    if mo_sel_enabled() {
+        let retlist_merges = retlist
+            .iter()
+            .filter(|&&i| {
+                !matches!(
+                    entries[i].outcome,
+                    PretendOutcome::AlreadyInstalled { .. } | PretendOutcome::NoVisibleCandidate
+                )
+            })
+            .count();
+        let alive = g.order.iter().filter(|&&i| g.alive[i]).count();
+        let pick: Vec<String> = selected
+            .iter()
+            .map(|&i| mo_sel_cpv(&entries[i], g.installed[i]))
+            .collect();
+        let asap_cpvs: Vec<String> = asap
+            .iter()
+            .filter(|&&i| g.alive[i])
+            .map(|&i| mo_sel_cpv(&entries[i], g.installed[i]))
+            .collect();
+        eprintln!(
+            "{}",
+            mo_sel_trace_line(MoSelTraceLineArgs {
+                iter: mo_iter,
+                retlist: retlist_merges,
+                alive,
+                asap: &asap_cpvs,
+                prefer_asap,
+                drop_satisfied,
+                ig: used_ig,
+                pick: &pick
+            })
+        );
+    }
+    prefer_asap = true;
+    drop_satisfied = false;
+    for i in selected {
+        if !g.alive[i] {
+            continue;
         }
-        g.order.retain(|&i| g.alive[i]);
+        g.alive[i] = false;
+        // Keep the frontier in sync at the loop's one removal site.
+        if let Some(fr) = frontier.as_mut() {
+            fr.remove(i, &g.children[i], &g.parents[i]);
+        }
+        // Selecting the blocked package while its uninstall is scheduled solves
+        // the blocker; selecting the synthetic uninstall itself discards it.
+        if let Some(ts) = tree.as_mut() {
+            tree_note_selection(g, entries, ts, i);
+        }
+        retlist.push(i);
     }
-    retlist
+    g.order.retain(|&i| g.alive[i]);
+    *prefer_asap_out = prefer_asap;
+    *drop_satisfied_out = drop_satisfied;
 }

+/// The values [`schedule_stuck_or_admit`] reads from its caller.
+pub(crate) struct ScheduleStuckOrAdmitArgs<'a, 'x0> {
+    pub(crate) selected: &'a Option<Vec<usize>>,
+    pub(crate) tree: &'a mut Option<&'x0 mut TreeStuck>,
+    pub(crate) g: &'a mut Digraph,
+    pub(crate) entries: &'a [GraphEntry],
+    pub(crate) prefer_asap: &'a mut bool,
+    pub(crate) drop_satisfied: &'a mut bool,
+    pub(crate) removals: &'a [usize],
+    pub(crate) scheduled: &'a mut HashSet<usize>,
+}
+
+/// Without a selection, schedule the stuck uninstall (tree mode) or admit the next removal; Break means a retry of the round.
+pub(crate) fn schedule_stuck_or_admit(args: ScheduleStuckOrAdmitArgs<'_, '_>) -> ControlFlow<()> {
+    let ScheduleStuckOrAdmitArgs {
+        selected,
+        tree,
+        g,
+        entries,
+        prefer_asap: prefer_asap_out,
+        drop_satisfied: drop_satisfied_out,
+        removals,
+        scheduled,
+    } = args;
+    let mut prefer_asap = *prefer_asap_out;
+    let mut drop_satisfied = *drop_satisfied_out;
+    // Stuck branch, tree-mode only: schedule an uninstall for the blocked package.
+    // The flat caller never takes it.
+    if selected.is_none()
+        && let Some(ts) = tree.as_mut()
+    {
+        tree_schedule_stuck(g, entries, ts);
+        if ts.progressed {
+            ts.progressed = false;
+            prefer_asap = true;
+            drop_satisfied = false;
+            {
+                *prefer_asap_out = prefer_asap;
+                *drop_satisfied_out = drop_satisfied;
+                return ControlFlow::Break(());
+            };
+        }
+    }
+
+    // Admission: no merge node selectable and a live unadmitted removal exists.
+    // Admit the first in graph order and re-select; sits before the roots
+    // last-resort so a waiting owner is never picked as a root first.
+    if selected.is_none()
+        && let Some(&r) = removals
+            .iter()
+            .find(|r| !scheduled.contains(r) && g.alive[**r])
+    {
+        scheduled.insert(r);
+        prefer_asap = true;
+        drop_satisfied = false;
+        {
+            *prefer_asap_out = prefer_asap;
+            *drop_satisfied_out = drop_satisfied;
+            return ControlFlow::Break(());
+        };
+    }
+    *prefer_asap_out = prefer_asap;
+    *drop_satisfied_out = drop_satisfied;
+    ControlFlow::Continue(())
+}

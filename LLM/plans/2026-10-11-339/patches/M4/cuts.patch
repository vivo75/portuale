+    {
+        portage_tmpdir
+    } else {
+        let process_tmpdir = std::env::var_os("PORTAGE_TMPDIR").map(std::path::PathBuf::from);
+        let ebuild_path = std::path::Path::new(ebuild_file);
+        match ebuild_phases::resolve_standalone_portage_tmpdir(
+            ebuild_path,

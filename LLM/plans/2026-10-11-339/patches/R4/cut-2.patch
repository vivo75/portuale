+/// Whether every atom of the group belongs to the running root.
+fn group_running(
+    atoms: &[String],
+    cross_running_root: Option<&Path>,
+    running_tags: &HashSet<String>,
+) -> bool {
+    cross_running_root.is_some() && atoms.iter().all(|a| running_tags.contains(a))

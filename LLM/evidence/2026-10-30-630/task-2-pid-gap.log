=== probe scripts ===
--- /tmp/pidns-probe.sh
self_ns=$(readlink /proc/self/ns/pid)
child_ns=$(bash -c 'readlink /proc/self/ns/pid')
if [ -n "$child_ns" ] && [ "$self_ns" != "$child_ns" ]; then
echo "PIDNS=1 self=$self_ns child=$child_ns"
exit 0
else
echo "PIDNS=0 self=$self_ns child=$child_ns"
exit 1
fi
--- /tmp/fork2.sh
bash -c 'echo one'
echo "first rc=$?"
bash -c 'echo two'
echo "second rc=$?"
--- /tmp/fork-alive.sh
sleep 5 &
bash -c 'echo two-while-init-alive'
echo "rc=$?"
wait
=== pid+mount+demote, two sequential forks ===
one
first rc=0
/tmp/fork2.sh: fork: Cannot allocate memory
rc=254
=== pid+mount+demote, second fork while PID1 alive ===
two-while-init-alive
rc=0
rc=0

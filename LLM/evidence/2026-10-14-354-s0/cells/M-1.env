T354_V=1
FEATURES=
PKGDIR=/var/tmp/t354/pkgX
PORTAGE_CONFIGROOT=/var/tmp/t354/cfg
ROOT=/var/tmp/t354/roots/M
BROOT=/var/tmp/t354/roots/M
PORTAGE_TMPDIR=/var/tmp/t354/scratch/M/tmp
PORTAGE_LOGDIR=/var/tmp/t354/scratch/M/logs
PORTAGE_DEPCACHEDIR=/var/tmp/t354/scratch/M/depcache
CONFIG_PROTECT_MASK="/etc/env.d /etc/t354" (exported by caller of scenario.sh M up)

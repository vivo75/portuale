__pipestatus () 
{ 
    local status=("${PIPESTATUS[@]}") s ret=0;
    for s in "${status[@]}";
    do
        [[ ${s} -ne 0 ]] && ret=${s};
    done;
    return "${ret}"
}
aclocal () 
{ 
    case ${FUNCNAME[1]} in 
        eautoreconf | eaclocal | _elibtoolize | eautoheader | eautoconf | eautomake | autotools_run_tool | autotools_check_macro | autotools_get_subdirs | autotools_get_auxdir)

        ;;
        *)
            eqawarn "QA Notice: 'aclocal' called by ${FUNCNAME[1]}: ${CATEGORY}/${PF}";
            eqawarn "Use autotools.eclass instead of calling 'aclocal' directly."
        ;;
    esac;
    /usr/bin/aclocal "$@";
    return $?
}
autoconf () 
{ 
    case ${FUNCNAME[1]} in 
        eautoreconf | eaclocal | _elibtoolize | eautoheader | eautoconf | eautomake | autotools_run_tool | autotools_check_macro | autotools_get_subdirs | autotools_get_auxdir)

        ;;
        *)
            eqawarn "QA Notice: 'autoconf' called by ${FUNCNAME[1]}: ${CATEGORY}/${PF}";
            eqawarn "Use autotools.eclass instead of calling 'autoconf' directly."
        ;;
    esac;
    /usr/bin/autoconf "$@";
    return $?
}
automake () 
{ 
    case ${FUNCNAME[1]} in 
        eautoreconf | eaclocal | _elibtoolize | eautoheader | eautoconf | eautomake | autotools_run_tool | autotools_check_macro | autotools_get_subdirs | autotools_get_auxdir)

        ;;
        *)
            eqawarn "QA Notice: 'automake' called by ${FUNCNAME[1]}: ${CATEGORY}/${PF}";
            eqawarn "Use autotools.eclass instead of calling 'automake' directly."
        ;;
    esac;
    /usr/bin/automake "$@";
    return $?
}
libtoolize () 
{ 
    case ${FUNCNAME[1]} in 
        eautoreconf | eaclocal | _elibtoolize | eautoheader | eautoconf | eautomake | autotools_run_tool | autotools_check_macro | autotools_get_subdirs | autotools_get_auxdir)

        ;;
        *)
            eqawarn "QA Notice: 'libtoolize' called by ${FUNCNAME[1]}: ${CATEGORY}/${PF}";
            eqawarn "Use autotools.eclass instead of calling 'libtoolize' directly."
        ;;
    esac;
    /usr/bin/libtoolize "$@";
    return $?
}

+/// Measurement only: one stderr line per late build edge.
+fn census_dump(
+    world: &World,
+    plan: &portage_world::BuildPlan<'_>,
+    root: &Path,
+    config_root: &Path,
+) {
+    let edges = match portage_world::late::census(world, plan, root, config_root) {
+        Ok(e) => e,
+        Err(m) => {
+            eprintln!("CENSUS-ERROR\t{m}");
+            return;
+        }
+    };
+    let yn = |b: bool| if b { "1" } else { "0" };
+    for (row, from, atom, bits, unmatched) in portage_world::late::no_target(world, plan) {
+        let vars: Vec<&str> = portage_world::DEP_KEYS
+            .iter()
+            .enumerate()
+            .filter(|(b, _)| bits & (1u8 << b) != 0)
+            .map(|(_, k)| *k)
+            .collect();
+        eprintln!(
+            "CENSUS-NOTARGET\t{from}\t{atom}\t{}\t{row}\t{}",
+            vars.join("|"),
+            yn(unmatched)
+        );
+    }
+    for e in edges {
+        let vars: Vec<&str> = portage_world::DEP_KEYS
+            .iter()
+            .enumerate()
+            .filter(|(b, _)| e.bits & (1u8 << b) != 0)
+            .map(|(_, k)| *k)
+            .collect();
+        let rows = if e.to_rows.is_empty() {
+            "-".to_string()
+        } else {
+            e.to_rows.iter().map(usize::to_string).collect::<Vec<_>>().join(",")
+        };
+        let pair = |p: &Option<(String, String)>| {
+            p.as_ref().map_or("-\t-".to_string(), |(a, b)| format!("{a}\t{b}"))
+        };
+        eprintln!(
+            "CENSUS\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}",
+            e.from,
+            e.to,
+            e.atom,
+            vars.join("|"),
+            e.row,
+            rows,
+            yn(!e.to_rows.is_empty()),
+            pair(&e.installed),
+            pair(&e.planned),
+            yn(e.met_by_installed),
+            yn(e.other_installed_slot_meets),
+            yn(e.in_scc),
+            yn(e.has_slot_op),
+            yn(e.in_depend),
+            yn(e.text_has_atom),
+            yn(e.or_displaced),
+        );
+    }
+}

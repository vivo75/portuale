+/// Arguments of [`unsatisfied_system_runtime_deps`].
+pub(crate) struct UnsatisfiedSystemDepsArgs<'a> {
+    pub(crate) entries: &'a [GraphEntry],
+    pub(crate) deps: &'a [HashSet<usize>],

# Real Portage merging a new package into a new category, from
# docs/evidence/317-s0-strace/1-merge-new.ops.txt (dblink.treewalk,
# vartree.py:5027-5241): info files copied into -MERGING-, COUNTER,
# CONTENTS and metadata through write_atomic (mkstemp temp, a _umask_test
# file, chmod, rename), the stamp appended last, then the publish rename.
# Contents are shortened; names, modes and order are real's.
mkdir app-misc 755
mkdir app-misc/-MERGING-foo-1.0 755
create app-misc/-MERGING-foo-1.0/USE 644
write app-misc/-MERGING-foo-1.0/USE \n
create app-misc/-MERGING-foo-1.0/CATEGORY 644
write app-misc/-MERGING-foo-1.0/CATEGORY app-misc\n
create app-misc/-MERGING-foo-1.0/SLOT 644
write app-misc/-MERGING-foo-1.0/SLOT 0\n
create app-misc/-MERGING-foo-1.0/PF 644
write app-misc/-MERGING-foo-1.0/PF foo-1.0\n
create app-misc/-MERGING-foo-1.0/EAPI 644
write app-misc/-MERGING-foo-1.0/EAPI 8\n
create app-misc/-MERGING-foo-1.0/environment.bz2 644
write app-misc/-MERGING-foo-1.0/environment.bz2 BZh91AY&SY\tbinary-ish
create app-misc/-MERGING-foo-1.0/repository 644
write app-misc/-MERGING-foo-1.0/repository gentoo\n
create app-misc/-MERGING-foo-1.0/COUNTER 644
write app-misc/-MERGING-foo-1.0/COUNTER 41
create app-misc/-MERGING-foo-1.0/CONTENTS3vxg4xiw 600
write app-misc/-MERGING-foo-1.0/CONTENTS3vxg4xiw dir /usr/share/foo\nobj /usr/share/foo/payload 0123456789abcdef 1791211770\n
create app-misc/-MERGING-foo-1.0/CONTENTS3vxg4xiw_umask_test 644
unlink app-misc/-MERGING-foo-1.0/CONTENTS3vxg4xiw_umask_test
chmod app-misc/-MERGING-foo-1.0/CONTENTS3vxg4xiw 644
rename app-misc/-MERGING-foo-1.0/CONTENTS3vxg4xiw app-misc/-MERGING-foo-1.0/CONTENTS
unlink? app-misc/-MERGING-foo-1.0/CONTENTS3vxg4xiw
create app-misc/-MERGING-foo-1.0/metadatasbr6vhiv 600
write app-misc/-MERGING-foo-1.0/metadatasbr6vhiv #format=1\nCOUNTER=41\nEAPI=8\nSLOT=0\nrepository=gentoo\n
create app-misc/-MERGING-foo-1.0/metadatasbr6vhiv_umask_test 644
unlink app-misc/-MERGING-foo-1.0/metadatasbr6vhiv_umask_test
chmod app-misc/-MERGING-foo-1.0/metadatasbr6vhiv 644
rename app-misc/-MERGING-foo-1.0/metadatasbr6vhiv app-misc/-MERGING-foo-1.0/metadata
unlink? app-misc/-MERGING-foo-1.0/metadatasbr6vhiv
stamp app-misc/-MERGING-foo-1.0/metadata app-misc/-MERGING-foo-1.0
rename app-misc/-MERGING-foo-1.0 app-misc/foo-1.0

# fixture package.accept_keywords: a bounded-wildcard entry (package name
# only, deliberately not "dev-libs/*" so it can't accidentally affect
# dev-libs/maskedpkg's own ~amd64-only-not-visible contract test) and a
# "**" entry (accept unconditionally, including packages with no KEYWORDS
# at all).
*/wildcardkeywordpkg ~amd64
dev-libs/livekeywordpkg **
dev-libs/unstableusepkg ~amd64
# "-amd64" negation: revokes the global ACCEPT_KEYWORDS="amd64" grant for
# this one stable package specifically (real KeywordsManager._getEgroups
# folds "-token" removals, not just additions).
dev-libs/keywordrevokedpkg -amd64

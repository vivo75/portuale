# fixture profile level: base of the chain, no parents.
# Exercises USE self-append *within* a single file (two lines, second one
# references ${USE} set by the first) -- this is the common real-world
# pattern (see e.g. the real tree's profiles/base/make.defaults).
USE="foo"
USE="${USE} bar"

# Exercises USE_EXPAND: VIDEO_CARDS="nvidia" expands into the pseudo-USE
# flag "video_cards_nvidia" (see dev-libs/useexpandpkg).
USE_EXPAND="VIDEO_CARDS"
VIDEO_CARDS="nvidia"

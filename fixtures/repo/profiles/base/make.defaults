# fixture profile level: base of the chain, no parents.
# Exercises USE self-append *within* a single file (two lines, second one
# references ${USE} set by the first) -- this is the common real-world
# pattern (see e.g. the real tree's profiles/base/make.defaults).
USE="foo"
USE="${USE} bar"

# Exercises USE_EXPAND: VIDEO_CARDS="nvidia" expands into the pseudo-USE
# flag "video_cards_nvidia" (see dev-libs/useexpandpkg).
USE_EXPAND="VIDEO_CARDS ELIBC"
VIDEO_CARDS="nvidia"

# Exercises USE_EXPAND_IMPLICIT: ELIBC is an implicit USE_EXPAND var, so
# elibc_glibc / elibc_musl are valid implicit IUSE for every package even
# when unlisted in its own IUSE (real profiles/base/make.defaults sets
# this for ARCH ELIBC KERNEL USERLAND). See dev-libs/implicitiusepkg.
USE_EXPAND_IMPLICIT="ELIBC"
USE_EXPAND_VALUES_ELIBC="glibc musl"
ELIBC="glibc"

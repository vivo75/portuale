# fixture profile level: arch, no parents.
# Exercises a non-USE scalar (ARCH) feeding ACCEPT_KEYWORDS via ${ARCH}
# substitution, mirroring the real tree's profiles/arch/amd64/make.defaults.
ARCH="amd64"
ACCEPT_KEYWORDS="${ARCH}"
# USE_EXPAND_UNPREFIXED: real Gentoo's own profiles/arch/amd64/make.defaults
# sets this too -- it's literally how "amd64" exists as a real, always-on
# USE flag at all (no "arch_" prefix, unlike an ordinary USE_EXPAND var).
USE_EXPAND_UNPREFIXED="ARCH"

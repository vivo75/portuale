From 868ff957990d442e82c0672279092a6e406d9a11 Mon Sep 17 00:00:00 2001
From: Francesco Riosa <me@francesco-riosa.com>
Date: Sun, 15 Nov 2026 16:36:44 +0000
Subject: [PATCH] test(expansion): cover brace expansion independence from IFS

The implementation is upstream's #988 IFS rework; this keeps the
regression case that rework did not cover: `IFS=` / `IFS=:` must not
collapse `{A..C}` into one space-joined word.
---
 brush-core/src/expansion.rs                   | 31 +++++++++++++++++++
 .../cases/compat/word_expansion/braces.yaml   | 15 +++++++++
 2 files changed, 46 insertions(+)

diff --git a/brush-core/src/expansion.rs b/brush-core/src/expansion.rs
index 63ea13e2..52492d49 100644
--- a/brush-core/src/expansion.rs
+++ b/brush-core/src/expansion.rs
@@ -2653,6 +2653,37 @@ mod tests {
         Ok(())
     }
 
+    /// Brace expansion produces fields on its own; it must not depend on
+    /// field splitting (i.e. IFS) to separate its alternatives. `IFS=` and
+    /// `IFS=:` used to collapse `{A..C}` into a single space-joined word,
+    /// which real `bin/phase-functions.sh`'s `__filter_readonly_variables`
+    /// trips over: it builds its special-variable list with
+    /// `printf '${!%s*} ' {A..Z} {a..z} _` inside a function that has already
+    /// run `local IFS`.
+    #[tokio::test]
+    async fn test_brace_expansion_does_not_depend_on_ifs() -> Result<()> {
+        for ifs in ["", ":"] {
+            let mut shell = crate::shell::Shell::builder().build().await?;
+            shell
+                .env_mut()
+                .set_global("IFS", crate::variables::ShellVariable::new(ifs))?;
+            let params = shell.default_exec_params();
+
+            assert_eq!(
+                full_expand_and_split_word(&mut shell, &params, "{A..C}").await?,
+                vec!["A", "B", "C"],
+                "IFS={ifs:?}"
+            );
+            assert_eq!(
+                full_expand_and_split_word(&mut shell, &params, "{a,}").await?,
+                vec!["a"],
+                "IFS={ifs:?}"
+            );
+        }
+
+        Ok(())
+    }
+
     #[test]
     fn test_replace_substring_inserts_replacement_verbatim() -> Result<()> {
         // A capture group, as an extglob pattern like `@(b)` produces.
diff --git a/brush-shell/tests/cases/compat/word_expansion/braces.yaml b/brush-shell/tests/cases/compat/word_expansion/braces.yaml
index 6133d444..d5757183 100644
--- a/brush-shell/tests/cases/compat/word_expansion/braces.yaml
+++ b/brush-shell/tests/cases/compat/word_expansion/braces.yaml
@@ -370,6 +370,21 @@ cases:
       arr=({a,b}c)
       echo "${#arr[@]}"
 
+  - name: "Expansion with curly braces does not depend on IFS"
+    stdin: |
+      IFS=
+      printf '<%s>' {A..C}
+      echo
+      printf '<%s>' {1,2}
+      echo
+      printf '<%s>' {a,}
+      echo
+      IFS=:
+      printf '<%s>' {A..C}
+      echo
+      printf '<%s>' x{1..3}y
+      echo
+
   - name: "A parameter expansion with braces inside a brace expression"
     known_failure: true # TODO(expansion): the `}` of `${u:-{1..2}}` is taken as the brace expression's; bash matches the parameter expansion's braces first
     stdin: |

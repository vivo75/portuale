From 07a3723a6ff2ede705b6e9bd15f6cd65ee80aba1 Mon Sep 17 00:00:00 2001
From: Francesco Riosa <me@francesco-riosa.com>
Date: Sun, 15 Nov 2026 16:36:41 +0000
Subject: [PATCH] fix(core): don't exit the calling shell on a `source` parse
 error

bash's `source`/`.` returns 2 and continues when the sourced file fails to
parse, so a `source f || die` guard fires; only a parse error in a script
run on the command line is fatal. brush marks every parse error fatal, so
clear the requested shell exit at the `source` boundary -- except in POSIX
mode, where a special builtin's error does end the shell.
---
 brush-core/src/shell/execution.rs             | 14 +++++++++++
 .../tests/cases/compat/builtins/dot.yaml      | 23 +++++++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/brush-core/src/shell/execution.rs b/brush-core/src/shell/execution.rs
index 3fe01545..6336c032 100644
--- a/brush-core/src/shell/execution.rs
+++ b/brush-core/src/shell/execution.rs
@@ -164,6 +164,7 @@ impl<SE: crate::extensions::ShellExtensions> crate::Shell<SE> {
         parse_result: Result<P, brush_parser::ParseError>,
         params: &ExecutionParameters,
     ) -> Result<ExecutionResult, error::Error> {
+        let parse_failed = parse_result.is_err();
         let mut result = self
             .enter_script(call_type, source_info, args.map(Into::into))
             .run_parsed_result(parse_result, source_info, params)
@@ -178,6 +179,19 @@ impl<SE: crate::extensions::ShellExtensions> crate::Shell<SE> {
             result.next_control_flow = ExecutionControlFlow::Normal;
         }
 
+        // A parse error in a sourced file is not fatal to the *calling* shell: bash's
+        // `source`/`.` returns 2 and execution continues (so a `source f || die` guard fires,
+        // and `set -e` still sees the status), where a parse error in a script run on the
+        // command line does terminate the shell. `run_parsed_result` marks every parse error
+        // fatal, so clear the requested shell exit at the `source` boundary -- except in POSIX
+        // mode, where a special builtin's error ends the shell as bash does.
+        if parse_failed
+            && matches!(call_type, callstack::ScriptCallType::Source)
+            && !self.options().posix_mode
+        {
+            result.next_control_flow = ExecutionControlFlow::Normal;
+        }
+
         Ok(result)
     }
 
diff --git a/brush-shell/tests/cases/compat/builtins/dot.yaml b/brush-shell/tests/cases/compat/builtins/dot.yaml
index edc96078..450577bc 100644
--- a/brush-shell/tests/cases/compat/builtins/dot.yaml
+++ b/brush-shell/tests/cases/compat/builtins/dot.yaml
@@ -115,6 +115,29 @@ cases:
       source script.sh
       echo "After source"
 
+  - name: "Source with a parse error returns 2 without exiting the caller"
+    ignore_stderr: true
+    test_files:
+      - path: "bad.sh"
+        contents: |
+          :
+          echo "unterminated
+    stdin: |
+      source ./bad.sh
+      echo "Result: $?"
+      echo "After source"
+
+  - name: "Source with a parse error on the left of ||"
+    ignore_stderr: true
+    test_files:
+      - path: "bad.sh"
+        contents: |
+          :
+          echo "unterminated
+    stdin: |
+      source ./bad.sh || echo "Caught: $?"
+      echo "After source"
+
   - name: "Source with break in caller's loop"
     test_files:
       - path: "script.sh"
-- 
